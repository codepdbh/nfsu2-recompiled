+/* An instruction the lifter could not express. It used to be a null statement
+ * (a bare `;` plus an UNIMPLEMENTED comment), so a body with one simply skipped it and carried on
+ * with wrong state -- the worst kind of failure a recompile has. The runtime
+ * says which guest address and which instruction, then stops. A host may
+ * define recomp_unimpl itself; this weak default prints and aborts. */
+void recomp_unimpl(uint32_t va, const char *what);
+#define RECOMP_UNIMPL(va, what) recomp_unimpl((va), (what))
+
 #endif /* RECOMP_TYPES_H */
